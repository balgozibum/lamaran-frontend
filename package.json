{
  "name": "lamaran-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "check:data": "node scripts/check-data.ts",
    "check:links": "node scripts/check-links.ts",
    "check": "npm run check:data && npm run lint && npm run build",
    "deploy": "bash scripts/deploy-gh-pages.sh",
    "deploy:vercel": "npx vercel deploy --prod"
  },
  "dependencies": {
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "lucide-react": "^1.52.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
